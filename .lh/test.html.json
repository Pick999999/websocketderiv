            "date": 1766437029512,
            "name": "Commit-0",
            "content": "<!DOCTYPE html>\r\n<html lang=\"th\">\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n    <title>Deriv WebSocket Test Client</title>\r\n    <style>\r\n        * {\r\n            margin: 0;\r\n            padding: 0;\r\n            box-sizing: border-box;\r\n        }\r\n        \r\n        body {\r\n            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;\r\n            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\r\n            min-height: 100vh;\r\n            padding: 20px;\r\n        }\r\n        \r\n        .container {\r\n            max-width: 900px;\r\n            margin: 0 auto;\r\n            background: white;\r\n            border-radius: 20px;\r\n            padding: 30px;\r\n            box-shadow: 0 20px 60px rgba(0,0,0,0.3);\r\n        }\r\n        \r\n        h1 {\r\n            color: #333;\r\n            margin-bottom: 10px;\r\n            font-size: 28px;\r\n        }\r\n        \r\n        .status {\r\n            display: inline-block;\r\n            padding: 8px 16px;\r\n            border-radius: 20px;\r\n            font-size: 14px;\r\n            font-weight: bold;\r\n            margin-bottom: 20px;\r\n        }\r\n        \r\n        .status.disconnected {\r\n            background: #fee;\r\n            color: #c33;\r\n        }\r\n        \r\n        .status.connected {\r\n            background: #efe;\r\n            color: #3c3;\r\n        }\r\n        \r\n        .controls {\r\n            display: grid;\r\n            grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));\r\n            gap: 10px;\r\n            margin-bottom: 20px;\r\n        }\r\n        \r\n        button {\r\n            padding: 12px 20px;\r\n            font-size: 14px;\r\n            font-weight: 600;\r\n            border: none;\r\n            border-radius: 8px;\r\n            cursor: pointer;\r\n            transition: all 0.3s;\r\n            color: white;\r\n        }\r\n        \r\n        button:hover {\r\n            transform: translateY(-2px);\r\n            box-shadow: 0 5px 15px rgba(0,0,0,0.2);\r\n        }\r\n        \r\n        button:active {\r\n            transform: translateY(0);\r\n        }\r\n        \r\n        .btn-connect {\r\n            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\r\n        }\r\n        \r\n        .btn-disconnect {\r\n            background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);\r\n        }\r\n        \r\n        .btn-action {\r\n            background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);\r\n        }\r\n        \r\n        .btn-clear {\r\n            background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);\r\n        }\r\n        \r\n        button:disabled {\r\n            opacity: 0.5;\r\n            cursor: not-allowed;\r\n            transform: none !important;\r\n        }\r\n        \r\n        .custom-request {\r\n            margin: 20px 0;\r\n            padding: 15px;\r\n            background: #f8f9fa;\r\n            border-radius: 10px;\r\n        }\r\n        \r\n        .custom-request h3 {\r\n            margin-bottom: 10px;\r\n            color: #555;\r\n        }\r\n        \r\n        textarea {\r\n            width: 100%;\r\n            padding: 10px;\r\n            border: 2px solid #ddd;\r\n            border-radius: 8px;\r\n            font-family: 'Courier New', monospace;\r\n            font-size: 13px;\r\n            resize: vertical;\r\n            min-height: 80px;\r\n        }\r\n        \r\n        textarea:focus {\r\n            outline: none;\r\n            border-color: #667eea;\r\n        }\r\n        \r\n        .messages-container {\r\n            background: #1e1e1e;\r\n            color: #d4d4d4;\r\n            padding: 20px;\r\n            border-radius: 10px;\r\n            max-height: 400px;\r\n            overflow-y: auto;\r\n            font-family: 'Courier New', monospace;\r\n            font-size: 13px;\r\n            line-height: 1.6;\r\n        }\r\n        \r\n        .messages-container h3 {\r\n            color: #fff;\r\n            margin-bottom: 15px;\r\n            font-family: 'Segoe UI', sans-serif;\r\n        }\r\n        \r\n        .message {\r\n            margin-bottom: 12px;\r\n            padding: 8px;\r\n            border-left: 3px solid #667eea;\r\n            padding-left: 12px;\r\n        }\r\n        \r\n        .message-sent {\r\n            border-left-color: #43e97b;\r\n        }\r\n        \r\n        .message-received {\r\n            border-left-color: #4facfe;\r\n        }\r\n        \r\n        .message-system {\r\n            border-left-color: #f5576c;\r\n            color: #ffa07a;\r\n        }\r\n        \r\n        .timestamp {\r\n            color: #888;\r\n            font-size: 11px;\r\n            margin-right: 8px;\r\n        }\r\n        \r\n        .message-type {\r\n            font-weight: bold;\r\n            margin-right: 8px;\r\n        }\r\n        \r\n        .sent { color: #43e97b; }\r\n        .received { color: #4facfe; }\r\n        .system { color: #f5576c; }\r\n        \r\n        ::-webkit-scrollbar {\r\n            width: 8px;\r\n        }\r\n        \r\n        ::-webkit-scrollbar-track {\r\n            background: #2d2d2d;\r\n        }\r\n        \r\n        ::-webkit-scrollbar-thumb {\r\n            background: #667eea;\r\n            border-radius: 4px;\r\n        }\r\n        \r\n        ::-webkit-scrollbar-thumb:hover {\r\n            background: #764ba2;\r\n        }\r\n    </style>\r\n</head>\r\n<body>\r\n    <div class=\"container\">\r\n        <h1>🚀 Deriv WebSocket Test Client</h1>\r\n        <div id=\"status\" class=\"status disconnected\">⚫ ไม่ได้เชื่อมต่อ</div>\r\n        \r\n        <div class=\"controls\">\r\n            <button class=\"btn-connect\" onclick=\"connect()\">🔌 เชื่อมต่อ</button>\r\n            <button class=\"btn-disconnect\" onclick=\"disconnect()\">🔴 ตัดการเชื่อมต่อ</button>\r\n            <button class=\"btn-action\" onclick=\"sendPing()\">📡 ส่ง Ping</button>\r\n            <button class=\"btn-action\" onclick=\"sendTicks()\">📊 Subscribe R_50</button>\r\n            <button class=\"btn-action\" onclick=\"sendActiveSymbols()\">📋 Active Symbols</button>\r\n            <button class=\"btn-clear\" onclick=\"clearMessages()\">🗑️ ล้างข้อความ</button>\r\n        </div>\r\n\r\n        <div class=\"custom-request\">\r\n            <h3>📝 ส่ง Request แบบกำหนดเอง (JSON)</h3>\r\n            <textarea id=\"customRequest\" placeholder='{\"ping\": 1}'></textarea>\r\n            <button class=\"btn-action\" onclick=\"sendCustom()\" style=\"margin-top: 10px; width: 100%;\">📤 ส่ง Custom Request</button>\r\n        </div>\r\n\r\n        <div class=\"messages-container\">\r\n            <h3>💬 ข้อความ</h3>\r\n            <div id=\"messages\"></div>\r\n        </div>\r\n    </div>\r\n\r\n    <script>\r\n        let ws = null;\r\n        const messagesDiv = document.getElementById('messages');\r\n        const statusDiv = document.getElementById('status');\r\n\r\n        function updateStatus(connected) {\r\n            if (connected) {\r\n                statusDiv.className = 'status connected';\r\n                statusDiv.textContent = '🟢 เชื่อมต่อแล้ว';\r\n            } else {\r\n                statusDiv.className = 'status disconnected';\r\n                statusDiv.textContent = '⚫ ไม่ได้เชื่อมต่อ';\r\n            }\r\n        }\r\n\r\n        function getTimestamp() {\r\n            const now = new Date();\r\n            return now.toLocaleTimeString('th-TH', { hour12: false });\r\n        }\r\n\r\n        function addMessage(msg, type = 'system') {\r\n            const messageEl = document.createElement('div');\r\n            messageEl.className = `message message-${type}`;\r\n            \r\n            const timestamp = `<span class=\"timestamp\">[${getTimestamp()}]</span>`;\r\n            const typeLabel = type === 'sent' ? '<span class=\"message-type sent\">📤 ส่ง:</span>' :\r\n                            type === 'received' ? '<span class=\"message-type received\">📥 รับ:</span>' :\r\n                            '<span class=\"message-type system\">ℹ️ ระบบ:</span>';\r\n            \r\n            messageEl.innerHTML = `${timestamp}${typeLabel}${escapeHtml(msg)}`;\r\n            messagesDiv.appendChild(messageEl);\r\n            messagesDiv.scrollTop = messagesDiv.scrollHeight;\r\n        }\r\n\r\n        function escapeHtml(text) {\r\n            const div = document.createElement('div');\r\n            div.textContent = text;\r\n            return div.innerHTML;\r\n        }\r\n\r\n        // ✨✨✨ เพิ่มใหม่: Auto-detect WebSocket URL ✨✨✨\r\n        function connect() {\r\n            if (ws && ws.readyState === WebSocket.OPEN) {\r\n                addMessage('เชื่อมต่ออยู่แล้ว!');\r\n                return;\r\n            }\r\n\r\n            // ตรวจสอบว่าเปิดจาก localhost หรือ production\r\n            // localhost = ใช้ ws:// (ไม่มี SSL)\r\n            // production = ใช้ wss:// (มี SSL)\r\n            const wsUrl = window.location.hostname === 'localhost' \r\n                ? 'ws://localhost:3000/ws'           // สำหรับทดสอบ local\r\n                : 'wss://pkderiv.shop/ws';           // สำหรับ production บน EC2\r\n            \r\n            // แสดง URL ที่จะเชื่อมต่อ\r\n            addMessage('กำลังเชื่อมต่อไปที่ ' + wsUrl + '...');\r\n            \r\n            // สร้าง WebSocket connection\r\n            ws = new WebSocket(wsUrl);\r\n            \r\n            ws.onopen = () => {\r\n                addMessage('✅ เชื่อมต่อสำเร็จ!');\r\n                updateStatus(true);\r\n            };\r\n\r\n            ws.onmessage = (event) => {\r\n                try {\r\n                    const data = JSON.parse(event.data);\r\n                    addMessage(JSON.stringify(data, null, 2), 'received');\r\n                } catch (e) {\r\n                    addMessage(event.data, 'received');\r\n                }\r\n            };\r\n\r\n            ws.onerror = (error) => {\r\n                addMessage('❌ เกิดข้อผิดพลาด: ตรวจสอบว่า Server ทำงานอยู่');\r\n                console.error('WebSocket error:', error);\r\n            };\r\n\r\n            ws.onclose = () => {\r\n                addMessage('🔌 การเชื่อมต่อถูกปิด');\r\n                updateStatus(false);\r\n            };\r\n        }\r\n\r\n        function disconnect() {\r\n            if (ws) {\r\n                ws.close();\r\n                ws = null;\r\n                addMessage('ตัดการเชื่อมต่อแล้ว');\r\n                updateStatus(false);\r\n            } else {\r\n                addMessage('ไม่มีการเชื่อมต่ออยู่');\r\n            }\r\n        }\r\n\r\n        function sendMessage(data) {\r\n            if (!ws || ws.readyState !== WebSocket.OPEN) {\r\n                addMessage('❌ ไม่ได้เชื่อมต่อ! กรุณากดปุ่ม \"เชื่อมต่อ\" ก่อน');\r\n                return false;\r\n            }\r\n            \r\n            const jsonStr = JSON.stringify(data);\r\n            ws.send(jsonStr);\r\n            addMessage(JSON.stringify(data, null, 2), 'sent');\r\n            return true;\r\n        }\r\n\r\n        function sendPing() {\r\n            sendMessage({ ping: 1 });\r\n        }\r\n\r\n        function sendTicks() {\r\n            sendMessage({ \r\n                ticks: \"R_50\", \r\n                subscribe: 1 \r\n            });\r\n        }\r\n\r\n        function sendActiveSymbols() {\r\n            sendMessage({\r\n                active_symbols: \"brief\",\r\n                product_type: \"basic\"\r\n            });\r\n        }\r\n\r\n        function sendCustom() {\r\n            const textarea = document.getElementById('customRequest');\r\n            const text = textarea.value.trim();\r\n            \r\n            if (!text) {\r\n                addMessage('❌ กรุณาใส่ JSON request');\r\n                return;\r\n            }\r\n\r\n            try {\r\n                const data = JSON.parse(text);\r\n                sendMessage(data);\r\n            } catch (e) {\r\n                addMessage('❌ JSON ไม่ถูกต้อง: ' + e.message);\r\n            }\r\n        }\r\n\r\n        function clearMessages() {\r\n            messagesDiv.innerHTML = '';\r\n            addMessage('ล้างข้อความแล้ว');\r\n        }\r\n\r\n        // เชื่อมต่ออัตโนมัติเมื่อเปิดหน้า\r\n        window.onload = () => {\r\n            // แสดงว่าจะเชื่อมต่อไปที่ไหน\r\n            const env = window.location.hostname === 'localhost' ? 'Local' : 'Production';\r\n            addMessage('🌐 Environment: ' + env);\r\n            addMessage('พร้อมใช้งาน! กดปุ่ม \"เชื่อมต่อ\" เพื่อเริ่มต้น');\r\n        };\r\n    </script>\r\n</body>\r\n</html>"
        }
    ]
}